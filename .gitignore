/worktrees/

# ワークツリーごとのポートのオフセット（scripts/dev-ports.ts）
.dev-port-offset

# 開発用のシークレット。例のファイルだけを git に入れる
.dev.vars
.dev.vars.*
!.dev.vars.example
.env
.env.*
!.env.example

# 依存と生成物
node_modules/
build/
.svelte-kit/
.wrangler/
vite.config.ts.timestamp-*
# e2e の結果（pnpm e2e）
test-results/
playwright-report/
.e2e-preflight/
# wrangler types が作る（scripts/prepare.ts）
worker-configuration.d.ts
# daily-scrum が毎回作る開発ボードのデータ（scripts/progress-data.ts）
.claude/skills/daily-scrum/page/data.json

# 外から入れたスキルが書くもの（docs/development.md の「外から入れたスキル」）。
# impeccable はフックを止めた config.json だけを入れ、同意の記録（config.local.json）と live の作業物は入れない
/.impeccable/*
!/.impeccable/config.json
# 照合されずに実行される同梱のエンジンを、差分から入れさせない
/.claude/skills/impeccable/scripts/bin/
# impeccable は Codex では使わない。npx skills update が作る実体を入れさせない
/.agents/skills/impeccable/
# improve-animations が書く動きの改善計画
/plans/
/animation-plans/

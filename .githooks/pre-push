#!/bin/sh
# リモートの main への push（削除と force push も含む）を止める。main は PR の squash merge でだけ進める
# リモートの production への push（削除も含む）も止める。production は Release のワークフローだけが進める
# リモートの v* のタグへの push（削除も含む）も止める。v* のタグは人が Release の publish で作る
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "main へは push しない。作業ブランチから PR を通す（docs/development.md の「\`main\` を守る仕組み」）" >&2
    exit 1
  fi
  if [ "$remote_ref" = "refs/heads/production" ]; then
    echo "production へは push しない。Release を publish すると、Release のワークフローが進める（docs/development.md の「ブランチ戦略」）" >&2
    exit 1
  fi
  case "$remote_ref" in
    refs/tags/v*)
      echo "v* のタグは push しない。Release の publish で作る（docs/development.md の「ブランチ戦略」）" >&2
      exit 1
      ;;
  esac
done
